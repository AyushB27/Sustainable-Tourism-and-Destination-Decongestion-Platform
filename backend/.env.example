# ==============================================================================
# EcoRoute Bharat - Live Sensor API Keys Configuration
# ==============================================================================
# Rename this file to '.env' in this directory (backend/.env)
# The backend will automatically pick up these keys on startup or reload.

# 1. TomTom Traffic Flow API (FREE - 2,500 calls/day, no credit card required)
# Get your free key at: https://developer.tomtom.com/user/register
# Once registered, go to "Keys" -> copy the Consumer API Key.
TOMTOM_API_KEY=

# 2. BestTime.app Live Footfall & Busyness API (FREE Tier)
# Get your free key at: https://besttime.app
# Go to API Dashboard -> copy your "Private API Key" (key_private).
BESTTIME_API_KEY=

# 3. Open Government Data India (data.gov.in - FREE)
# Get your API key at: https://data.gov.in
# Used for live calibration of domestic tourism statistics.
DATA_GOV_IN_API_KEY=

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
