# ==============================================================================
# EcoRoute Bharat - Backend API Keys Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# 1. TomTom Traffic API (https://developer.tomtom.com/)
TOMTOM_API_KEY=

# 2. BestTime.app Footfall API (https://besttime.app/)
BESTTIME_API_KEY=

# 3. Open Government Data India (https://data.gov.in/user/me)
DATA_GOV_IN_API_KEY=

# OGD India Resource IDs:
OGD_STATE_RESOURCE_ID=38e073e6-404c-45df-8c7f-18bad688d8df
OGD_COASTAL_RESOURCE_ID=51b5fc1c-9a4b-4c36-bcba-a90e55dc9fc8

# 4. Backend Server Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
